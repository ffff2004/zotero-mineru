{
  "name": "zotero-mineru",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "description": "MinerU integration for Zotero.",
  "config": {
    "addonName": "Zotero MinerU",
    "addonID": "zotero-mineru@ffff2004",
    "addonRef": "mineru",
    "addonInstance": "MinerU",
    "prefsPrefix": "extensions.zotero.mineru"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffff2004/zotero-mineru.git"
  },
  "author": "ffff2004",
  "bugs": {
    "url": "https://github.com/ffff2004/zotero-mineru/issues"
  },
  "homepage": "https://github.com/ffff2004/zotero-mineru#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "test:helper": "uv run --no-project --with pymupdf python -B -m unittest discover -s skills/zotero-mineru/tests -v",
    "update-deps": "pnpm update"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
